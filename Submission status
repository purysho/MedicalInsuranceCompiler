<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#9fb18b",
                        "background-light": "#f7f7f7",
                        "background-dark": "#191b17",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                },
            },
        }
    </script>
<title>Submission Success - Compiler App</title>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100">
<div class="relative flex h-screen w-full overflow-hidden">
<!-- Side Navigation -->
<aside class="w-64 flex-shrink-0 border-r border-primary/20 bg-background-light dark:bg-background-dark p-6 flex flex-col justify-between">
<div class="flex flex-col gap-8">
<div class="flex items-center gap-3">
<div class="bg-primary/20 p-2 rounded-lg">
<span class="material-symbols-outlined text-primary text-3xl">medical_services</span>
</div>
<div class="flex flex-col">
<h1 class="text-slate-900 dark:text-slate-100 text-base font-bold leading-none">Compiler App</h1>
<p class="text-slate-500 dark:text-slate-400 text-xs font-normal">Insurance Specialist</p>
</div>
</div>
<nav class="flex flex-col gap-2">
<a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-primary/10 transition-colors" href="#">
<span class="material-symbols-outlined text-slate-600 dark:text-slate-400">dashboard</span>
<p class="text-sm font-medium">Dashboard</p>
</a>
<a class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/20 text-primary" href="#">
<span class="material-symbols-outlined font-fill">description</span>
<p class="text-sm font-bold">Pipeline</p>
</a>
<a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-primary/10 transition-colors" href="#">
<span class="material-symbols-outlined text-slate-600 dark:text-slate-400">stethoscope</span>
<p class="text-sm font-medium">Claims</p>
</a>
<a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-primary/10 transition-colors" href="#">
<span class="material-symbols-outlined text-slate-600 dark:text-slate-400">group</span>
<p class="text-sm font-medium">Patients</p>
</a>
<a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-primary/10 transition-colors" href="#">
<span class="material-symbols-outlined text-slate-600 dark:text-slate-400">settings</span>
<p class="text-sm font-medium">Settings</p>
</a>
</nav>
</div>
<div class="flex items-center gap-3 p-4 bg-primary/5 rounded-xl">
<div class="size-10 rounded-full bg-primary flex items-center justify-center text-white font-bold">JD</div>
<div class="flex flex-col overflow-hidden">
<p class="text-xs font-bold truncate">Jane Doe</p>
<p class="text-[10px] text-slate-500 dark:text-slate-400 truncate">Senior Reviewer</p>
</div>
</div>
</aside>
<!-- Main Content Area -->
<main class="flex-1 flex flex-col overflow-y-auto">
<header class="flex items-center justify-between px-10 py-6 border-b border-primary/10">
<div class="flex items-center gap-4">
<div class="bg-primary/10 p-2 rounded-lg">
<span class="material-symbols-outlined text-primary">task_alt</span>
</div>
<h2 class="text-xl font-bold tracking-tight">Submission Status</h2>
</div>
<div class="flex items-center gap-4">
<button class="flex items-center justify-center size-10 rounded-full bg-primary/10 text-slate-700 dark:text-slate-300">
<span class="material-symbols-outlined text-xl">notifications</span>
</button>
<button class="flex items-center justify-center size-10 rounded-full bg-primary/10 text-slate-700 dark:text-slate-300">
<span class="material-symbols-outlined text-xl">help</span>
</button>
</div>
</header>
<div class="flex-1 flex flex-col items-center justify-center p-8">
<!-- Success Card -->
<div class="max-w-2xl w-full bg-white dark:bg-background-dark border border-primary/20 rounded-xl p-12 text-center shadow-xl shadow-primary/5">
<div class="mb-8 flex justify-center">
<div class="relative">
<div class="absolute inset-0 bg-primary/20 rounded-full scale-150 blur-xl"></div>
<div class="relative size-24 rounded-full bg-primary flex items-center justify-center text-white">
<span class="material-symbols-outlined text-5xl">check_circle</span>
</div>
</div>
</div>
<h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100 mb-4">Submission Successful</h1>
<p class="text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto">
                        The medical authorization for <span class="font-bold text-slate-900 dark:text-slate-100 italic">Case #4829-PX</span> has been successfully transmitted to the payer network.
                    </p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10 text-left">
<div class="p-4 rounded-xl bg-primary/5 border border-primary/10">
<p class="text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mb-1">Auth ID</p>
<p class="text-xl font-mono font-bold text-primary">AUTH-9928-8831-XP</p>
</div>
<div class="p-4 rounded-xl bg-primary/5 border border-primary/10">
<p class="text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mb-1">Payer Reference</p>
<p class="text-xl font-mono font-bold text-primary">BLUE-C-49201</p>
</div>
</div>
<div class="mb-10 text-left border-l-4 border-primary pl-6 py-2">
<h3 class="font-bold text-slate-900 dark:text-slate-100 mb-2">Next Steps</h3>
<ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
<li class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary text-lg">schedule</span>
<span>Payer review typically takes 24-48 business hours.</span>
</li>
<li class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary text-lg">mail</span>
<span>A notification will be sent to the patient and provider via the preferred channel.</span>
</li>
<li class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary text-lg">visibility</span>
<span>You can track real-time status changes in your pipeline.</span>
</li>
</ul>
</div>
<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
<button class="w-full sm:w-auto px-8 py-4 bg-primary text-white font-bold rounded-xl hover:opacity-90 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">view_list</span>
                            Return to Pipeline
                        </button>
<button class="w-full sm:w-auto px-8 py-4 bg-primary/10 text-primary font-bold rounded-xl hover:bg-primary/20 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">print</span>
                            Print Summary
                        </button>
</div>
</div>
<!-- Abstract Decorative Pattern -->
<div class="mt-12 opacity-30">
<div class="flex gap-4">
<div class="h-2 w-2 rounded-full bg-primary"></div>
<div class="h-2 w-12 rounded-full bg-primary/40"></div>
<div class="h-2 w-2 rounded-full bg-primary"></div>
</div>
</div>
</div>
</main>
</div>
</body></html>
